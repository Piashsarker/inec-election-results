# INEC Election Results Agent - Environment Configuration
# Copy this file to .env and update values as needed

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inec_elections
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Scraping Configuration (Requirement 6.1, 6.5)
# Leave empty to scrape all available data
SCRAPING_TARGET_ELECTION_TYPE=
SCRAPING_TARGET_STATE=
SCRAPING_TARGET_LGA=
SCRAPING_TARGET_WARD=

# Rate Limiting (Requirement 6.5)
SCRAPING_MAX_CONCURRENT_REQUESTS=5
SCRAPING_REQUEST_DELAY_SECONDS=1.0
SCRAPING_MAX_RETRIES=5
SCRAPING_BACKOFF_FACTOR=2.0
SCRAPING_DOWNLOAD_TIMEOUT_SECONDS=30
SCRAPING_STORAGE_PATH=./data/result_sheets

# OCR Configuration
OCR_TESSERACT_LANG=eng
OCR_TESSERACT_CONFIG=--psm 6
OCR_QUALITY_THRESHOLD=0.7
OCR_CONFIDENCE_THRESHOLD=0.8

# Storage Configuration — Cloudflare R2 / AWS S3 / compatible
# Leave S3_BUCKET empty to use local filesystem fallback
S3_BUCKET=
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
# Leave empty for AWS S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional: public CDN URL for the bucket (e.g. https://images.yourdomain.com)
S3_PUBLIC_URL_BASE=

# OpenAI Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.0

# Celery Configuration
# CELERY_BROKER_URL=  # Defaults to Redis URL
# CELERY_RESULT_BACKEND=  # Defaults to Redis URL
CELERY_TASK_DEFAULT_QUEUE=inec_tasks
CELERY_WORKER_CONCURRENCY=4

# Logging Configuration (Requirement 7.6)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILE_SIZE_MB=10
LOG_BACKUP_COUNT=5

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# INEC Portal
INEC_PORTAL_URL=https://www.inecelectionresults.ng/elections/types
